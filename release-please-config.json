  "packages": {
    ".": {
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "gleam.toml",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "packages/notify_core/gleam.toml",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "manifest.toml",
          "jsonpath": "$.packages[?(@.name == 'notify_core')].version"
        },
        {
          "type": "generic",
          "path": "packages/notify_core/mix.exs"
        },
        {
          "type": "toml",
          "path": "web/gleam.toml",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
