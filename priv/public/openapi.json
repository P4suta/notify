{
  "openapi": "3.1.0",
  "info": {
    "title": "Notify API",
    "version": "0.1.0",
    "description": "Notify management API and the implemented ntfy v2.27.0-compatible wire surface."
  },
  "servers": [{"url": "/"}],
  "x-notify-rate-limits": {
    "description": "Non-operational requests consume a general token bucket and may also consume an independent subscription, publish/topic-creation, authentication-failure, attachment-MiB, or attachment-upload bucket. PostgreSQL cluster mode updates buckets atomically across nodes.",
    "attachmentBandwidthUnit": "MiB rounded up per request or response",
    "response": {"$ref": "#/components/responses/RateLimited"}
  },
  "tags": [
    {"name": "ntfy compatibility"},
    {"name": "session"},
    {"name": "administration"},
    {"name": "operations"}
  ],
  "paths": {
    "/healthz": {"get": {"operationId": "getLiveness", "tags": ["operations"], "summary": "Process liveness probe", "responses": {"200": {"description": "Process is alive", "content": {"text/plain": {"schema": {"type": "string"}}}}}}},
    "/readyz": {"get": {"operationId": "getReadiness", "tags": ["operations"], "summary": "Dependency readiness probe", "responses": {"200": {"description": "Ready"}, "503": {"description": "A required dependency is unavailable"}}}},
    "/metrics": {"get": {"operationId": "getMetrics", "tags": ["operations"], "summary": "Prometheus metrics", "responses": {"200": {"description": "Prometheus text exposition", "content": {"text/plain": {"schema": {"type": "string"}}}}}}},
    "/": {
      "post": {"operationId": "publishJsonPost", "tags": ["ntfy compatibility"], "summary": "Publish a notification from message JSON", "security": [{"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/templateHeader"}, {"$ref": "#/components/parameters/messageHeader"}, {"$ref": "#/components/parameters/titleHeader"}, {"$ref": "#/components/parameters/priorityHeader"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["topic"], "properties": {"topic": {"type": "string"}, "message": {"type": "string"}, "title": {"type": "string"}, "priority": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 5}, {"type": "string"}]}}}}}}, "responses": {"200": {"description": "Committed message", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}}, "400": {"$ref": "#/components/responses/NtfyError"}, "413": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}},
      "put": {"operationId": "publishJsonPut", "tags": ["ntfy compatibility"], "summary": "Publish a notification from message JSON", "security": [{"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/templateHeader"}, {"$ref": "#/components/parameters/messageHeader"}, {"$ref": "#/components/parameters/titleHeader"}, {"$ref": "#/components/parameters/priorityHeader"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "Committed message"}, "400": {"$ref": "#/components/responses/NtfyError"}, "413": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/{topic}": {
      "parameters": [{"$ref": "#/components/parameters/topic"}],
      "post": {"operationId": "publishTopicPost", "tags": ["ntfy compatibility"], "summary": "Publish a notification", "security": [{"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/templateHeader"}, {"$ref": "#/components/parameters/messageHeader"}, {"$ref": "#/components/parameters/titleHeader"}, {"$ref": "#/components/parameters/priorityHeader"}], "requestBody": {"required": true, "content": {"text/plain": {"schema": {"type": "string"}}, "application/json": {"schema": {"type": "object", "description": "JSON source when message templating is enabled"}}, "application/octet-stream": {"schema": {"type": "string", "contentEncoding": "binary"}}}}, "responses": {"200": {"description": "Committed message", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}}, "400": {"$ref": "#/components/responses/NtfyError"}, "413": {"$ref": "#/components/responses/NtfyError"}, "403": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}},
      "put": {"operationId": "publishTopicPut", "tags": ["ntfy compatibility"], "summary": "Publish a notification", "security": [{"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/templateHeader"}, {"$ref": "#/components/parameters/messageHeader"}, {"$ref": "#/components/parameters/titleHeader"}, {"$ref": "#/components/parameters/priorityHeader"}], "requestBody": {"required": true, "content": {"text/plain": {"schema": {"type": "string"}}, "application/json": {"schema": {"type": "object", "description": "JSON source when message templating is enabled"}}}}, "responses": {"200": {"description": "Committed message"}, "400": {"$ref": "#/components/responses/NtfyError"}, "413": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/file/{topic}/{key}/{filename}": {
      "parameters": [{"$ref": "#/components/parameters/topic"}, {"$ref": "#/components/parameters/attachmentKey"}, {"$ref": "#/components/parameters/attachmentFilename"}],
      "get": {"operationId": "downloadAttachment", "tags": ["ntfy compatibility"], "summary": "Download an attachment referenced by the topic", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}},
      "head": {"operationId": "headAttachment", "tags": ["ntfy compatibility"], "summary": "Inspect an attachment referenced by the topic", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/file/{topic}/{key}": {
      "parameters": [{"$ref": "#/components/parameters/topic"}, {"$ref": "#/components/parameters/attachmentKey"}],
      "get": {"operationId": "downloadAttachmentLegacy", "tags": ["ntfy compatibility"], "summary": "Download an attachment using the legacy filename-less URL", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}},
      "head": {"operationId": "headAttachmentLegacy", "tags": ["ntfy compatibility"], "summary": "Inspect an attachment using the legacy filename-less URL", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/{topics}/json": {"get": {"operationId": "subscribeJson", "tags": ["ntfy compatibility"], "summary": "Subscribe as NDJSON or poll cached messages", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}, {"name": "poll", "in": "query", "schema": {"type": "boolean"}}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "NDJSON stream", "content": {"application/x-ndjson": {"schema": {"type": "string"}}}}, "400": {"$ref": "#/components/responses/NtfyError"}}}},
    "/{topics}/sse": {"get": {"operationId": "subscribeSse", "tags": ["ntfy compatibility"], "summary": "Subscribe using server-sent events", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "SSE stream", "content": {"text/event-stream": {"schema": {"type": "string"}}}}}}},
    "/{topics}/raw": {"get": {"operationId": "subscribeRaw", "tags": ["ntfy compatibility"], "summary": "Subscribe as plaintext", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Plaintext stream"}}}},
    "/{topics}/ws": {"get": {"operationId": "subscribeWebSocket", "tags": ["ntfy compatibility"], "summary": "Subscribe over WebSocket", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"101": {"description": "WebSocket upgraded"}}}},
    "/{topics}/auth": {"get": {"operationId": "authorizeTopics", "tags": ["ntfy compatibility"], "summary": "Check topic read access", "parameters": [{"$ref": "#/components/parameters/topics"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Authorized"}, "403": {"$ref": "#/components/responses/NtfyError"}}}},
    "/v1/health": {"get": {"operationId": "getCompatHealth", "tags": ["ntfy compatibility"], "summary": "Liveness and storage health", "responses": {"200": {"description": "Healthy"}, "503": {"description": "Storage unavailable"}}}, "head": {"operationId":"headCompatHealth","tags":["ntfy compatibility"],"summary":"Inspect compatibility health without a response body","responses":{"200":{"description":"Server process is accepting requests"}}}},
    "/v1/version": {"get": {"operationId": "getVersion", "tags": ["ntfy compatibility"], "summary": "Server and compatibility versions", "responses": {"200": {"description": "Version information"}}}},
    "/v1/config": {"get": {"operationId": "getClientConfig", "tags": ["ntfy compatibility"], "summary": "Public client capabilities", "responses": {"200": {"description": "Client configuration"}}}},
    "/v1/webpush": {
      "post": {"operationId": "upsertWebPush", "tags": ["ntfy compatibility"], "summary": "Create or replace a browser Push API subscription", "security": [{"basicAuth": []}, {"bearerAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebPushSubscription"}}}}, "responses": {"200": {"description": "Subscription updated"}, "400": {"$ref": "#/components/responses/NtfyError"}, "403": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"operationId": "deleteWebPush", "tags": ["ntfy compatibility"], "summary": "Remove a browser Push API subscription", "security": [{"basicAuth": []}, {"bearerAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["endpoint"], "properties": {"endpoint": {"type": "string", "format": "uri"}}}}}}, "responses": {"200": {"description": "Subscription removed"}, "403": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/v1/stats": {"get": {"operationId": "getStats", "tags": ["ntfy compatibility"], "summary": "Public message statistics", "responses": {"200": {"description": "Statistics"}}}},
    "/v1/account": {
      "get": {"operationId": "getAccount", "tags": ["ntfy compatibility"], "summary": "Read anonymous or authenticated account limits and statistics", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "ntfy account response"}, "401": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"operationId": "deleteAccount", "tags": ["ntfy compatibility"], "summary": "Delete the authenticated account after password confirmation", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Account deleted"}, "400": {"$ref": "#/components/responses/NtfyError"}, "409": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/v1/account/login": {"post": {"operationId": "loginAccount", "tags": ["ntfy compatibility"], "summary": "Authenticate and mint a 72-hour token", "security": [{"basicAuth": []}], "responses": {"200": {"description": "Raw token and canonical username"}, "401": {"$ref": "#/components/responses/NtfyError"}}}},
    "/v1/account/password": {"post": {"operationId": "changeAccountPassword", "tags": ["ntfy compatibility"], "summary": "Change the authenticated user's password", "security": [{"basicAuth": []}, {"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["password", "new_password"], "properties": {"password": {"type": "string", "format": "password", "writeOnly": true}, "new_password": {"type": "string", "format": "password", "writeOnly": true, "minLength": 12}}}}}}, "responses": {"200": {"description": "Password changed"}, "400": {"$ref": "#/components/responses/NtfyError"}}}},
    "/v1/account/token": {
      "post": {"operationId": "createAccountToken", "tags": ["ntfy compatibility"], "summary": "Create an API token; the raw value is returned once", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "New raw token"}, "400": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"operationId": "deleteAccountToken", "tags": ["ntfy compatibility"], "summary": "Revoke a token supplied in X-Token, Token query, or bearer credentials", "security": [{"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "X-Token", "in": "header", "schema": {"type": "string", "writeOnly": true}}], "responses": {"200": {"description": "Token revoked"}, "400": {"$ref": "#/components/responses/NtfyError"}}},
      "patch": {"operationId":"rejectAccountTokenUpdate","tags":["ntfy compatibility"],"summary":"Reject unsupported in-place token updates","description":"Notify intentionally returns the ntfy-compatible invalid-request error; revoke the token and create a replacement.","security":[{"basicAuth":[]},{"bearerAuth":[]}],"responses":{"400":{"$ref":"#/components/responses/NtfyError"},"401":{"$ref":"#/components/responses/NtfyError"}}}
    },
    "/v1/users": {
      "get": {"operationId": "listCompatUsers", "tags": ["ntfy compatibility"], "summary": "List ntfy-format users and grants", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User array"}, "401": {"$ref": "#/components/responses/NtfyError"}}},
      "post": {"operationId": "createCompatUser", "tags": ["ntfy compatibility"], "summary": "Create a regular user", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User created"}, "409": {"$ref": "#/components/responses/NtfyError"}}},
      "put": {"operationId": "updateCompatUser", "tags": ["ntfy compatibility"], "summary": "Change a regular user's password or create the user", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User changed"}, "400": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"operationId": "deleteCompatUser", "tags": ["ntfy compatibility"], "summary": "Delete a regular user", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User deleted"}, "400": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/v1/users/access": {
      "post": {"operationId": "createCompatAccess", "tags": ["ntfy compatibility"], "summary": "Create or replace a user's topic grant", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Grant changed"}, "400": {"$ref": "#/components/responses/NtfyError"}}},
      "put": {"operationId": "updateCompatAccess", "tags": ["ntfy compatibility"], "summary": "Create or replace a user's topic grant", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Grant changed"}}},
      "delete": {"operationId": "deleteCompatAccess", "tags": ["ntfy compatibility"], "summary": "Remove a user's topic grant", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Grant removed"}}}
    },
    "/api/v1/setup": {"post": {"operationId": "completeSetup", "tags": ["session"], "summary": "Consume the one-time setup challenge", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SetupRequest"}}}}, "responses": {"201": {"description": "Administrator created"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/session": {
      "post": {"operationId": "createSession", "tags": ["session"], "summary": "Create an HttpOnly web session", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"201": {"description": "Session created; raw token is only set as a cookie"}, "401": {"$ref": "#/components/responses/Problem"}}},
      "get": {"operationId": "getSession", "tags": ["session"], "summary": "Inspect the current session and obtain its CSRF token", "responses": {"200": {"description": "Current session"}, "401": {"$ref": "#/components/responses/Problem"}}},
      "delete": {"operationId": "deleteSession", "tags": ["session"], "summary": "Revoke the current session", "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Session revoked"}, "403": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/users": {
      "get": {"operationId": "listUsers", "tags": ["administration"], "summary": "List users", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/cursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "User page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserPage"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}},
      "post": {"operationId": "createUser", "tags": ["administration"], "summary": "Create a user", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NewUser"}}}}, "responses": {"201": {"description": "User created"}, "409": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/users/{username}": {"delete": {"operationId": "deleteUser", "tags": ["administration"], "summary": "Delete a user and their Push API subscriptions", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "username", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "User deleted"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/users/{username}/password": {"put": {"operationId": "changeUserPassword", "tags": ["administration"], "summary": "Replace a user's password", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "username", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Password changed"}}}},
    "/api/v1/tokens": {
      "get": {"operationId": "listTokens", "tags": ["administration"], "summary": "List token metadata; raw tokens are never returned", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "username", "in": "query", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/cursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "Token metadata page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPage"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}},
      "post": {"operationId": "createToken", "tags": ["administration"], "summary": "Create a token; the raw value is returned once", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"201": {"description": "New token"}}}
    },
    "/api/v1/tokens/{id}": {"delete": {"operationId": "deleteToken", "tags": ["administration"], "summary": "Revoke a token", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Token revoked"}}}},
    "/api/v1/acl": {
      "get": {"operationId": "listAcl", "tags": ["administration"], "summary": "List ACL rules", "security": [{"basicAuth": []}, {"sessionCookie": []}], "responses": {"200": {"description": "ACL rule page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AclPage"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}, "parameters": [{"name": "username", "in": "query", "description": "Optional exact username filter; cursors are bound to this value", "schema": {"type": "string"}}, {"$ref": "#/components/parameters/cursor"}, {"$ref": "#/components/parameters/limit"}]},
      "put": {"operationId": "updateAcl", "tags": ["administration"], "summary": "Create or replace an ACL rule", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"200": {"description": "ACL rule"}}},
      "delete": {"operationId": "deleteAcl", "tags": ["administration"], "summary": "Delete an ACL rule", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "ACL rule deleted"}}},
      "post": {"operationId":"createAcl","tags":["administration"],"summary":"Create or replace an ACL rule","security":[{"basicAuth":[]},{"sessionCookie":[]}],"parameters":[{"$ref":"#/components/parameters/csrf"}],"responses":{"200":{"description":"ACL rule"},"400":{"$ref":"#/components/responses/Problem"},"403":{"$ref":"#/components/responses/Problem"}}}
    },
    "/api/v1/anonymous-access": {"get": {"operationId": "getAnonymousAccess", "tags": ["administration"], "summary": "Read the default anonymous ACL", "security": [{"basicAuth": []}, {"sessionCookie": []}], "responses": {"200": {"description": "Anonymous policy"}}}, "put": {"operationId": "updateAnonymousAccess", "tags": ["administration"], "summary": "Replace the default anonymous ACL", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"200": {"description": "Anonymous policy updated"}}}},
    "/api/v1/system/health": {"get": {"operationId": "getSystemHealth", "tags": ["administration"], "summary": "Detailed storage, attachment, delivery, audit, and Web Push health", "security": [{"basicAuth": []}, {"sessionCookie": []}], "responses": {"200": {"description": "Healthy"}, "503": {"description": "A dependency is unavailable"}}}},
    "/api/v1/delivery-jobs": {"get": {"operationId": "listDeliveryJobs", "tags": ["administration"], "summary": "Inspect durable Web Push and mobile relay jobs without message payloads", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "kind", "in": "query", "schema": {"type": "string", "enum": ["webpush", "mobile_relay"]}}, {"$ref": "#/components/parameters/cursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "Delivery job page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeliveryJobPage"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/delivery-jobs/{id}/retry": {"post": {"operationId": "retryDeliveryJob", "tags": ["administration"], "summary": "Requeue a dead-letter delivery job and reset its attempt count", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"200": {"description": "Requeued delivery job"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/delivery-jobs/{id}": {"delete": {"operationId": "purgeDeliveryJob", "tags": ["administration"], "summary": "Purge a dead-letter delivery job", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Delivery job purged"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/attachments": {"get": {"operationId": "listAttachments", "tags": ["administration"], "summary": "List attachment metadata", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/cursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "Attachment metadata page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AttachmentPage"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/attachments/{key}": {"delete": {"operationId": "deleteAttachment", "tags": ["administration"], "summary": "Delete an attachment object", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "key", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Attachment deleted"}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/audit": {"get": {"operationId": "listAuditEvents", "tags": ["administration"], "summary": "List redacted append-only security and administration audit events", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/auditCursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "Newest-first audit page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuditPage"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/{topic}/{message_or_action}": {
      "parameters": [{"$ref":"#/components/parameters/topic"}],
