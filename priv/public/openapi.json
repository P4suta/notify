{
  "openapi": "3.1.0",
  "info": {
    "title": "Notify API",
    "version": "0.1.0",
    "description": "Notify management API and the implemented ntfy v2.27.0-compatible wire surface."
  },
  "servers": [{"url": "/"}],
  "x-notify-rate-limits": {
    "description": "Non-operational requests consume a general token bucket and may also consume an independent subscription, publish/topic-creation, authentication-failure, attachment-MiB, or attachment-upload bucket. PostgreSQL cluster mode updates buckets atomically across nodes.",
    "attachmentBandwidthUnit": "MiB rounded up per request or response",
    "response": {"$ref": "#/components/responses/RateLimited"}
  },
  "tags": [
    {"name": "ntfy compatibility"},
    {"name": "session"},
    {"name": "administration"},
    {"name": "operations"}
  ],
  "paths": {
    "/healthz": {"get": {"tags": ["operations"], "summary": "Process liveness probe", "responses": {"200": {"description": "Process is alive", "content": {"text/plain": {"schema": {"type": "string"}}}}}}},
    "/readyz": {"get": {"tags": ["operations"], "summary": "Dependency readiness probe", "responses": {"200": {"description": "Ready"}, "503": {"description": "A required dependency is unavailable"}}}},
    "/metrics": {"get": {"tags": ["operations"], "summary": "Prometheus metrics", "responses": {"200": {"description": "Prometheus text exposition", "content": {"text/plain": {"schema": {"type": "string"}}}}}}},
    "/{topic}": {
      "parameters": [{"$ref": "#/components/parameters/topic"}],
      "post": {"tags": ["ntfy compatibility"], "summary": "Publish a notification", "security": [{"basicAuth": []}, {"bearerAuth": []}], "requestBody": {"required": true, "content": {"text/plain": {"schema": {"type": "string"}}, "application/octet-stream": {"schema": {"type": "string", "contentEncoding": "binary"}}}}, "responses": {"200": {"description": "Committed message", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Message"}}}}, "400": {"$ref": "#/components/responses/NtfyError"}, "403": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}},
      "put": {"tags": ["ntfy compatibility"], "summary": "Publish a notification", "security": [{"basicAuth": []}, {"bearerAuth": []}], "requestBody": {"required": true, "content": {"text/plain": {"schema": {"type": "string"}}}}, "responses": {"200": {"description": "Committed message"}}}
    },
    "/file/{topic}/{key}/{filename}": {
      "parameters": [{"$ref": "#/components/parameters/topic"}, {"$ref": "#/components/parameters/attachmentKey"}, {"$ref": "#/components/parameters/attachmentFilename"}],
      "get": {"tags": ["ntfy compatibility"], "summary": "Download an attachment referenced by the topic", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}},
      "head": {"tags": ["ntfy compatibility"], "summary": "Inspect an attachment referenced by the topic", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/file/{topic}/{key}": {
      "parameters": [{"$ref": "#/components/parameters/topic"}, {"$ref": "#/components/parameters/attachmentKey"}],
      "get": {"tags": ["ntfy compatibility"], "summary": "Download an attachment using the legacy filename-less URL", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}},
      "head": {"tags": ["ntfy compatibility"], "summary": "Inspect an attachment using the legacy filename-less URL", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/range"}, {"$ref": "#/components/parameters/ifNoneMatch"}], "responses": {"200": {"$ref": "#/components/responses/Attachment"}, "206": {"$ref": "#/components/responses/AttachmentRange"}, "304": {"description": "The content-addressed ETag matched"}, "404": {"$ref": "#/components/responses/NtfyError"}, "416": {"$ref": "#/components/responses/NtfyError"}, "503": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/{topics}/json": {"get": {"tags": ["ntfy compatibility"], "summary": "Subscribe as NDJSON or poll cached messages", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}, {"name": "poll", "in": "query", "schema": {"type": "boolean"}}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "NDJSON stream", "content": {"application/x-ndjson": {"schema": {"type": "string"}}}}, "400": {"$ref": "#/components/responses/NtfyError"}}}},
    "/{topics}/sse": {"get": {"tags": ["ntfy compatibility"], "summary": "Subscribe using server-sent events", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "SSE stream", "content": {"text/event-stream": {"schema": {"type": "string"}}}}}}},
    "/{topics}/raw": {"get": {"tags": ["ntfy compatibility"], "summary": "Subscribe as plaintext", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Plaintext stream"}}}},
    "/{topics}/ws": {"get": {"tags": ["ntfy compatibility"], "summary": "Subscribe over WebSocket", "parameters": [{"$ref": "#/components/parameters/topics"}, {"$ref": "#/components/parameters/since"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"101": {"description": "WebSocket upgraded"}}}},
    "/{topics}/auth": {"get": {"tags": ["ntfy compatibility"], "summary": "Check topic read access", "parameters": [{"$ref": "#/components/parameters/topics"}], "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Authorized"}, "403": {"$ref": "#/components/responses/NtfyError"}}}},
    "/v1/health": {"get": {"tags": ["ntfy compatibility"], "summary": "Liveness and storage health", "responses": {"200": {"description": "Healthy"}, "503": {"description": "Storage unavailable"}}}},
    "/v1/version": {"get": {"tags": ["ntfy compatibility"], "summary": "Server and compatibility versions", "responses": {"200": {"description": "Version information"}}}},
    "/v1/config": {"get": {"tags": ["ntfy compatibility"], "summary": "Public client capabilities", "responses": {"200": {"description": "Client configuration"}}}},
    "/v1/webpush": {
      "post": {"tags": ["ntfy compatibility"], "summary": "Create or replace a browser Push API subscription", "security": [{"basicAuth": []}, {"bearerAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebPushSubscription"}}}}, "responses": {"200": {"description": "Subscription updated"}, "400": {"$ref": "#/components/responses/NtfyError"}, "403": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"tags": ["ntfy compatibility"], "summary": "Remove a browser Push API subscription", "security": [{"basicAuth": []}, {"bearerAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["endpoint"], "properties": {"endpoint": {"type": "string", "format": "uri"}}}}}}, "responses": {"200": {"description": "Subscription removed"}, "403": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/v1/stats": {"get": {"tags": ["ntfy compatibility"], "summary": "Public message statistics", "responses": {"200": {"description": "Statistics"}}}},
    "/v1/account": {
      "get": {"tags": ["ntfy compatibility"], "summary": "Read anonymous or authenticated account limits and statistics", "security": [{}, {"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "ntfy account response"}, "401": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"tags": ["ntfy compatibility"], "summary": "Delete the authenticated account after password confirmation", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Account deleted"}, "400": {"$ref": "#/components/responses/NtfyError"}, "409": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/v1/account/login": {"post": {"tags": ["ntfy compatibility"], "summary": "Authenticate and mint a 72-hour token", "security": [{"basicAuth": []}], "responses": {"200": {"description": "Raw token and canonical username"}, "401": {"$ref": "#/components/responses/NtfyError"}}}},
    "/v1/account/password": {"post": {"tags": ["ntfy compatibility"], "summary": "Change the authenticated user's password", "security": [{"basicAuth": []}, {"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["password", "new_password"], "properties": {"password": {"type": "string", "format": "password", "writeOnly": true}, "new_password": {"type": "string", "format": "password", "writeOnly": true, "minLength": 12}}}}}}, "responses": {"200": {"description": "Password changed"}, "400": {"$ref": "#/components/responses/NtfyError"}}}},
    "/v1/account/token": {
      "post": {"tags": ["ntfy compatibility"], "summary": "Create an API token; the raw value is returned once", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "New raw token"}, "400": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"tags": ["ntfy compatibility"], "summary": "Revoke a token supplied in X-Token, Token query, or bearer credentials", "security": [{"basicAuth": []}, {"bearerAuth": []}], "parameters": [{"name": "X-Token", "in": "header", "schema": {"type": "string", "writeOnly": true}}], "responses": {"200": {"description": "Token revoked"}, "400": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/v1/users": {
      "get": {"tags": ["ntfy compatibility"], "summary": "List ntfy-format users and grants", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User array"}, "401": {"$ref": "#/components/responses/NtfyError"}}},
      "post": {"tags": ["ntfy compatibility"], "summary": "Create a regular user", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User created"}, "409": {"$ref": "#/components/responses/NtfyError"}}},
      "put": {"tags": ["ntfy compatibility"], "summary": "Change a regular user's password or create the user", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User changed"}, "400": {"$ref": "#/components/responses/NtfyError"}}},
      "delete": {"tags": ["ntfy compatibility"], "summary": "Delete a regular user", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "User deleted"}, "400": {"$ref": "#/components/responses/NtfyError"}}}
    },
    "/v1/users/access": {
      "post": {"tags": ["ntfy compatibility"], "summary": "Create or replace a user's topic grant", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Grant changed"}, "400": {"$ref": "#/components/responses/NtfyError"}}},
      "put": {"tags": ["ntfy compatibility"], "summary": "Create or replace a user's topic grant", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Grant changed"}}},
      "delete": {"tags": ["ntfy compatibility"], "summary": "Remove a user's topic grant", "security": [{"basicAuth": []}, {"bearerAuth": []}], "responses": {"200": {"description": "Grant removed"}}}
    },
    "/api/v1/setup": {"post": {"tags": ["session"], "summary": "Consume the one-time setup challenge", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SetupRequest"}}}}, "responses": {"201": {"description": "Administrator created"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/session": {
      "post": {"tags": ["session"], "summary": "Create an HttpOnly web session", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"201": {"description": "Session created; raw token is only set as a cookie"}, "401": {"$ref": "#/components/responses/Problem"}}},
      "get": {"tags": ["session"], "summary": "Inspect the current session and obtain its CSRF token", "responses": {"200": {"description": "Current session"}, "401": {"$ref": "#/components/responses/Problem"}}},
      "delete": {"tags": ["session"], "summary": "Revoke the current session", "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Session revoked"}, "403": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/users": {
      "get": {"tags": ["administration"], "summary": "List users", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/cursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "Cursor page"}}},
      "post": {"tags": ["administration"], "summary": "Create a user", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NewUser"}}}}, "responses": {"201": {"description": "User created"}, "409": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/users/{username}": {"delete": {"tags": ["administration"], "summary": "Delete a user and their Push API subscriptions", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "username", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "User deleted"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/users/{username}/password": {"put": {"tags": ["administration"], "summary": "Replace a user's password", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "username", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Password changed"}}}},
    "/api/v1/tokens": {
      "get": {"tags": ["administration"], "summary": "List token metadata; raw tokens are never returned", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "username", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Token metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenPage"}}}}}},
      "post": {"tags": ["administration"], "summary": "Create a token; the raw value is returned once", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"201": {"description": "New token"}}}
    },
    "/api/v1/tokens/{id}": {"delete": {"tags": ["administration"], "summary": "Revoke a token", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Token revoked"}}}},
    "/api/v1/acl": {
      "get": {"tags": ["administration"], "summary": "List ACL rules", "security": [{"basicAuth": []}, {"sessionCookie": []}], "responses": {"200": {"description": "ACL rules"}}},
      "put": {"tags": ["administration"], "summary": "Create or replace an ACL rule", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"200": {"description": "ACL rule"}}},
      "delete": {"tags": ["administration"], "summary": "Delete an ACL rule", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "ACL rule deleted"}}}
    },
    "/api/v1/anonymous-access": {"get": {"tags": ["administration"], "summary": "Read the default anonymous ACL", "security": [{"basicAuth": []}, {"sessionCookie": []}], "responses": {"200": {"description": "Anonymous policy"}}}, "put": {"tags": ["administration"], "summary": "Replace the default anonymous ACL", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/csrf"}], "responses": {"200": {"description": "Anonymous policy updated"}}}},
    "/api/v1/system/health": {"get": {"tags": ["administration"], "summary": "Detailed storage, attachment, delivery, audit, and Web Push health", "security": [{"basicAuth": []}, {"sessionCookie": []}], "responses": {"200": {"description": "Healthy"}, "503": {"description": "A dependency is unavailable"}}}},
    "/api/v1/delivery-jobs": {"get": {"tags": ["administration"], "summary": "Inspect durable Web Push and mobile relay jobs without message payloads", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "kind", "in": "query", "schema": {"type": "string", "enum": ["webpush", "mobile_relay"]}}], "responses": {"200": {"description": "Delivery job page"}}}},
    "/api/v1/delivery-jobs/{id}/retry": {"post": {"tags": ["administration"], "summary": "Requeue a dead-letter delivery job and reset its attempt count", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"200": {"description": "Requeued delivery job"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/delivery-jobs/{id}": {"delete": {"tags": ["administration"], "summary": "Purge a dead-letter delivery job", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Delivery job purged"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/attachments": {"get": {"tags": ["administration"], "summary": "List attachment metadata", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/cursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "Attachment page"}}}},
    "/api/v1/attachments/{key}": {"delete": {"tags": ["administration"], "summary": "Delete an attachment object", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"name": "key", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, {"$ref": "#/components/parameters/csrf"}], "responses": {"204": {"description": "Attachment deleted"}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/audit": {"get": {"tags": ["administration"], "summary": "List redacted append-only security and administration audit events", "security": [{"basicAuth": []}, {"sessionCookie": []}], "parameters": [{"$ref": "#/components/parameters/auditCursor"}, {"$ref": "#/components/parameters/limit"}], "responses": {"200": {"description": "Newest-first audit page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuditPage"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {"type": "http", "scheme": "basic"},
      "bearerAuth": {"type": "http", "scheme": "bearer"},
      "sessionCookie": {"type": "apiKey", "in": "cookie", "name": "notify_session"}
    },
    "parameters": {
      "topic": {"name": "topic", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[-_A-Za-z0-9]{1,64}$"}},
      "topics": {"name": "topics", "in": "path", "required": true, "schema": {"type": "string", "description": "Comma-separated topic names"}},
      "since": {"name": "since", "in": "query", "schema": {"oneOf": [{"type": "string", "enum": ["all", "none", "latest"]}, {"type": "string", "pattern": "^[A-Za-z0-9]{12}$"}, {"type": "integer"}]}},
      "attachmentKey": {"name": "key", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "attachmentFilename": {"name": "filename", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 255}},
      "range": {"name": "Range", "in": "header", "schema": {"type": "string", "pattern": "^bytes=[0-9]*-[0-9]*$"}},
      "ifNoneMatch": {"name": "If-None-Match", "in": "header", "schema": {"type": "string"}},
      "csrf": {"name": "X-CSRF-Token", "in": "header", "required": false, "description": "Required for cookie-authenticated mutations", "schema": {"type": "string"}},
      "cursor": {"name": "cursor", "in": "query", "schema": {"type": "string"}},
      "auditCursor": {"name": "cursor", "in": "query", "description": "Opaque, resource-scoped base64url keyset cursor returned by the preceding audit page", "schema": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}},
      "limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}
    },
    "schemas": {
      "Message": {"type": "object", "required": ["id", "time", "event", "topic"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9]{12}$"}, "time": {"type": "integer"}, "expires": {"type": "integer"}, "event": {"type": "string", "enum": ["open", "keepalive", "message", "message_delete", "message_clear", "poll_request"]}, "topic": {"type": "string"}, "message": {"type": "string", "maxLength": 4096, "x-max-bytes": 4096}, "title": {"type": "string"}, "priority": {"type": "integer", "minimum": 1, "maximum": 5}, "tags": {"type": "array", "items": {"type": "string"}}, "markdown": {"type": "boolean"}, "actions": {"type": "array", "maxItems": 3, "items": {"$ref": "#/components/schemas/Action"}}, "attachment": {"$ref": "#/components/schemas/MessageAttachment"}, "sequence_id": {"type": "string"}}},
      "MessageAttachment": {"type": "object", "required": ["name", "url"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 255}, "url": {"type": "string", "format": "uri"}, "type": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "expires": {"type": "integer"}}},
      "Action": {"type": "object", "required": ["id", "action", "label", "clear"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9]{10}$"}, "action": {"type": "string", "enum": ["view", "http", "copy"]}, "label": {"type": "string", "minLength": 1}, "url": {"type": "string"}, "method": {"type": "string"}, "headers": {"type": "object", "additionalProperties": {"type": "string"}}, "body": {"type": "string"}, "value": {"type": "string"}, "clear": {"type": "boolean"}}},
      "SetupRequest": {"type": "object", "required": ["token", "username", "password"], "properties": {"token": {"type": "string", "writeOnly": true}, "username": {"type": "string", "minLength": 1, "maxLength": 64}, "password": {"type": "string", "format": "password", "writeOnly": true, "minLength": 12}, "anonymous_access": {"type": "string", "enum": ["deny", "read", "write", "read-write"], "default": "deny"}}},
      "LoginRequest": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password", "writeOnly": true}}},
      "NewUser": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password", "writeOnly": true, "minLength": 12}, "role": {"type": "string", "enum": ["user", "admin"], "default": "user"}}},
      "TokenMetadata": {"type": "object", "required": ["id", "user_id", "prefix", "label", "created_at", "expires", "last_access"], "properties": {"id": {"type": "string"}, "user_id": {"type": "string"}, "prefix": {"type": "string", "description": "Non-secret display prefix"}, "label": {"type": "string"}, "created_at": {"type": "integer"}, "expires": {"type": ["integer", "null"]}, "last_access": {"type": ["integer", "null"], "description": "Latest successful bearer authentication time; monotonically non-decreasing"}}},
      "TokenPage": {"type": "object", "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/TokenMetadata"}}, "next_cursor": {"type": ["string", "null"]}}},
      "AuditEvent": {"type": "object", "required": ["sequence", "occurred_at", "actor", "action", "target", "outcome", "status", "client_ip", "request_id"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "occurred_at": {"type": "integer", "minimum": 0}, "actor": {"type": "string", "minLength": 1, "maxLength": 64}, "action": {"type": "string", "enum": ["setup.complete", "session.login", "session.logout", "user.create", "user.update", "user.delete", "user.password_change", "token.create", "token.revoke", "acl.change", "acl.revoke", "anonymous_access.change", "delivery.retry", "delivery.purge", "attachment.delete"]}, "target": {"type": ["string", "null"], "minLength": 1, "maxLength": 256, "description": "Resource path or identifier only; query strings and request bodies are never stored"}, "outcome": {"type": "string", "enum": ["attempted", "succeeded", "failed", "denied"]}, "status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}, "client_ip": {"type": "string", "minLength": 1, "maxLength": 64}, "request_id": {"type": "string", "minLength": 1, "maxLength": 64}}},
      "AuditPage": {"type": "object", "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/AuditEvent"}}, "next_cursor": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$", "description": "Opaque base64url keyset cursor"}}},
      "WebPushSubscription": {"type": "object", "required": ["endpoint", "auth", "p256dh", "topics"], "properties": {"endpoint": {"type": "string", "format": "uri"}, "auth": {"type": "string", "writeOnly": true}, "p256dh": {"type": "string", "writeOnly": true}, "topics": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[-_A-Za-z0-9]{1,64}$"}}}},
      "NtfyError": {"type": "object", "required": ["code", "http", "error"], "properties": {"code": {"type": "integer"}, "http": {"type": "integer"}, "error": {"type": "string"}, "link": {"type": "string", "format": "uri"}}},
      "Problem": {"type": "object", "required": ["type", "title", "status", "detail"], "properties": {"type": {"type": "string", "format": "uri-reference"}, "title": {"type": "string"}, "status": {"type": "integer"}, "detail": {"type": "string"}}}
    },
    "responses": {
      "Attachment": {"description": "Complete attachment body or HEAD metadata", "headers": {"ETag": {"schema": {"type": "string"}}, "Accept-Ranges": {"schema": {"type": "string", "const": "bytes"}}, "Content-Disposition": {"schema": {"type": "string"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "contentEncoding": "binary"}}}},
      "AttachmentRange": {"description": "Requested attachment byte range", "headers": {"ETag": {"schema": {"type": "string"}}, "Content-Range": {"schema": {"type": "string"}}, "Accept-Ranges": {"schema": {"type": "string", "const": "bytes"}}, "Content-Disposition": {"schema": {"type": "string"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "contentEncoding": "binary"}}}},
      "RateLimited": {"description": "A client token bucket has insufficient credit", "headers": {"Retry-After": {"required": true, "schema": {"type": "integer", "minimum": 1}}, "RateLimit-Limit": {"required": true, "schema": {"type": "integer", "minimum": 1}}, "RateLimit-Remaining": {"required": true, "schema": {"type": "integer", "minimum": 0}}, "RateLimit-Reset": {"required": true, "schema": {"type": "integer", "minimum": 1, "description": "Seconds until the bucket is full"}}, "X-Notify-RateLimit-Bucket": {"required": true, "schema": {"type": "string", "enum": ["request", "subscription", "topic_creation", "auth_failure", "attachment_bandwidth", "attachment_quota"]}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NtfyError"}}}},
      "NtfyError": {"description": "ntfy-compatible error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NtfyError"}}}},
      "Problem": {"description": "RFC 9457 problem details", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
    }
  }
