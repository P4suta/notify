      "get": {"operationId":"deleteMessageAlias","tags":["ntfy compatibility"],"summary":"Publish a delete event through the GET compatibility alias","security":[{"basicAuth":[]},{"bearerAuth":[]}],"responses":{"200":{"description":"Committed message event","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}},"400":{"$ref":"#/components/responses/NtfyError"},"403":{"$ref":"#/components/responses/NtfyError"},"503":{"$ref":"#/components/responses/NtfyError"}}}
    },
