      "get": {"operationId":"clearMessageGet","tags":["ntfy compatibility"],"summary":"Publish a clear event through the GET compatibility alias","security":[{"basicAuth":[]},{"bearerAuth":[]}],"responses":{"200":{"description":"Committed message event","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}},"400":{"$ref":"#/components/responses/NtfyError"},"403":{"$ref":"#/components/responses/NtfyError"},"503":{"$ref":"#/components/responses/NtfyError"}}},
      "put": {"operationId":"clearMessagePut","tags":["ntfy compatibility"],"summary":"Publish a clear event for a client-defined sequence","security":[{"basicAuth":[]},{"bearerAuth":[]}],"responses":{"200":{"description":"Committed message event","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}},"400":{"$ref":"#/components/responses/NtfyError"},"403":{"$ref":"#/components/responses/NtfyError"},"503":{"$ref":"#/components/responses/NtfyError"}}}
    }
