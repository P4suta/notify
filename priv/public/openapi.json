      "post": {"operationId":"updateMessagePost","tags":["ntfy compatibility"],"summary":"Publish an update for a client-defined sequence","security":[{"basicAuth":[]},{"bearerAuth":[]}],"parameters":[{"name":"message_or_action","in":"path","required":true,"description":"Client-defined sequence ID for update and control operations","schema":{"type":"string","minLength":1,"maxLength":64}},{"$ref":"#/components/parameters/templateHeader"}],"requestBody":{"required":true,"content":{"text/plain":{"schema":{"type":"string","maxLength":4096,"x-max-bytes":4096}},"application/json":{"schema":{"type":"object","description":"JSON source when message templating is enabled"}}}},"responses":{"200":{"description":"Committed message event","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}},"400":{"$ref":"#/components/responses/NtfyError"},"403":{"$ref":"#/components/responses/NtfyError"},"503":{"$ref":"#/components/responses/NtfyError"}}},
      "put": {"operationId":"updateMessagePut","tags":["ntfy compatibility"],"summary":"Publish an update for a client-defined sequence","security":[{"basicAuth":[]},{"bearerAuth":[]}],"parameters":[{"name":"message_or_action","in":"path","required":true,"description":"Client-defined sequence ID for update and control operations","schema":{"type":"string","minLength":1,"maxLength":64}},{"$ref":"#/components/parameters/templateHeader"}],"requestBody":{"required":true,"content":{"text/plain":{"schema":{"type":"string","maxLength":4096,"x-max-bytes":4096}},"application/json":{"schema":{"type":"object","description":"JSON source when message templating is enabled"}}}},"responses":{"200":{"description":"Committed message event","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}},"400":{"$ref":"#/components/responses/NtfyError"},"403":{"$ref":"#/components/responses/NtfyError"},"503":{"$ref":"#/components/responses/NtfyError"}}},
      "delete": {"operationId":"deleteMessage","tags":["ntfy compatibility"],"summary":"Publish a delete event for a client-defined sequence","security":[{"basicAuth":[]},{"bearerAuth":[]}],"parameters":[{"name":"message_or_action","in":"path","required":true,"description":"Client-defined sequence ID for update and control operations","schema":{"type":"string","minLength":1,"maxLength":64}}],"responses":{"200":{"description":"Committed message event","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Message"}}}},"400":{"$ref":"#/components/responses/NtfyError"},"403":{"$ref":"#/components/responses/NtfyError"},"503":{"$ref":"#/components/responses/NtfyError"}}}
    },
